# Copy to `.env` in this directory before starting the stack:
#   cp docker/.env.example docker/.env
#
# `docker/.env` itself is gitignored (it holds your HF token), so this template
# is the only GPU/CPU guidance a fresh clone gets. Every value below is optional
# -- the compose defaults are already CPU-safe and correct on a machine with no
# NVIDIA GPU, which is the common case.

# Hugging Face token used to pull the DamageTriageFormer checkpoint and the
# DINOv3 backbone. Required for damage-triage inference. Generate one at
# https://huggingface.co/settings/tokens (read scope is enough).
HF_TOKEN=

# Docker group id used by containers that talk to the host docker socket.
# 0 is correct on Docker Desktop (Windows/macOS). On native Linux set it to
# the host's docker group: `getent group docker | cut -d: -f3`.
DOCKER_GID=0

# Keep per-task working directories after a run instead of deleting them.
# Useful when debugging a failed pipeline step; costs disk.
PRESERVE_LOCAL_TASK_DIRS=1

# ---------------------------------------------------------------------------
# GPU
# ---------------------------------------------------------------------------
# Do NOT set HASTE_ENABLE_GPU=1 here. GPU mode has two halves that must move
# together -- the torch build inside the training image (TORCH_VARIANT) and the
# device request LocalRunner attaches to task containers (HASTE_ENABLE_GPU) --
# and this file can only set the second. Setting it alone gives you task
# containers that request a GPU while running a CPU-only torch, or a failed
# container start if the host has no NVIDIA device at all.
#
# Use the overlay instead, which sets both:
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up --build
#
# Verify the host can actually do GPU passthrough first:
#   docker run --rm --gpus all nvidia/cuda:12.4.1-base-ubuntu22.04 nvidia-smi
#
# Restrict which devices the overlay exposes (default: all):
# HASTE_GPU_DEVICES=0

# ---------------------------------------------------------------------------
# Large-AOI assessment (docs/haste-advancement/)
# ---------------------------------------------------------------------------
# docker-compose.yml supplies dev defaults for all of these. The code has no
# built-in fallback for the hardware-dependent ones: the API refuses a
# submit without HASTE_AOI_MAX_AREA_KM2, and the queue worker fails an
# assessment if HASTE_REGION_WINDOWS_PER_BATCH, HASTE_AOI_MAX_UNITS or
# HASTE_REGION_LEASE_SECONDS is missing. Replace the dev defaults with values
# measured on your hardware (seconds per window, memory per batch).
#
# Largest AOI a user may submit, in km².
# HASTE_AOI_MAX_AREA_KM2=500
# Most 1024 px windows one assessment may create (rejected above this).
# HASTE_AOI_MAX_UNITS=500
# Windows per runner task. One task re-downloads its TIF, so larger batches
# amortise the download; smaller batches lose less work on a failure.
# HASTE_REGION_WINDOWS_PER_BATCH=20
# Building masks per forward pass (unset = all masks of a window at once).
# HASTE_REGION_MASKS_PER_FORWARD=64
# Runner tasks in flight per assessment.
# HASTE_REGION_MAX_CONCURRENT_BATCHES=1
# Attempts per batch before it is marked failed.
# HASTE_REGION_MAX_ATTEMPTS=3
# Lease per running batch, seconds. Must exceed the slowest expected batch.
# HASTE_REGION_LEASE_SECONDS=300
# Below this share of valid pixels a building gets result_status=insufficient_data.
# HASTE_REGION_MIN_VALID_FRACTION=0.5
# Below this confidence a result is marked uncertain (unset = disabled).
# HASTE_REGION_UNCERTAIN_CONFIDENCE=
# imagenet (matches DamageTriageFormer training) or unit (legacy /255).
# HASTE_DTF_NORMALIZATION=imagenet
# Map: aggregates below this zoom, building polygons at or above it.
# HASTE_MAP_FEATURE_MIN_ZOOM=14
# HASTE_MAP_MAX_FEATURES=5000
# true: imagery prep also writes one COG per source TIF and catalogues each
# (for AOIs spanning many TIFs); false: only the mosaic is catalogued.
# HASTE_IMAGERY_CATALOG_MODE=false
